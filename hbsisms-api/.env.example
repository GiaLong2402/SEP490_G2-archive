# Copy to .env (git-ignored). Spring Boot reads it on startup.
DB_URL=jdbc:postgresql://localhost:5432/hbsisms
DB_USERNAME=postgres
DB_PASSWORD=change-me

# openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_TTL=PT8H

CORS_ALLOWED_ORIGINS=http://localhost:5180,http://localhost:5173

# Only used on first start, when the database has no user yet.
SEED_ADMIN_PASSWORD=change-me-too

# Swagger UI at /api/v1/swagger-ui.html — set false in production
SWAGGER_ENABLED=true

# update (dev) | validate (prod)
JPA_DDL_AUTO=update
